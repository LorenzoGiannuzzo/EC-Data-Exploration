# ── PostgreSQL / PostGIS ─────────────────────────────────────────────────────
POSTGRES_USER=data_explorer
POSTGRES_PASSWORD=DaranXVII17!
POSTGRES_DB=data_explorer
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Used by backend (constructed from above)
DATABASE_URL=postgresql+psycopg://data_explorer:DaranXVII17!@postgres:5432/data_explorer

# ── Backend (FastAPI) ────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# ── Frontend (Streamlit) ─────────────────────────────────────────────────────
BACKEND_URL=http://backend:8000   # how Streamlit reaches FastAPI inside docker-compose
STREAMLIT_PORT=8501

# ── Ingestion ────────────────────────────────────────────────────────────────
# Folder on host that contains the monthly subdirectories (ago24/, ago25/, ...).
# Mounted read-only into the backend container at /data/raw
HOST_DATA_DIR=./data
